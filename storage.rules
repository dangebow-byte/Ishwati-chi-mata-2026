rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email == 'dangebow@gmail.com' &&
        request.auth.token.email_verified == true;
    }

    function isVideoUpload() {
      return isAdmin() &&
        request.resource.size <= 500 * 1024 * 1024 &&
        request.resource.contentType.matches('video/(mp4|webm|quicktime|ogg)');
    }

    function isImageUpload() {
      return isAdmin() &&
        request.resource.size <= 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    function isAudioUpload() {
      return isAdmin() &&
        request.resource.size <= 50 * 1024 * 1024 &&
        request.resource.contentType.matches('audio/.*');
    }

    match /gallery_videos/{fileName} {
      allow read: if true;
      allow create, update: if isVideoUpload();
      allow delete: if isAdmin();
    }

    match /ashtami_videos/{fileName} {
      allow read: if true;
      allow create, update: if isVideoUpload();
      allow delete: if isAdmin();
    }

    match /gallery_photos/{fileName} {
      allow read: if true;
      allow create, update: if isImageUpload();
      allow delete: if isAdmin();
    }

    match /soundboard_audio/{fileName} {
      allow read: if true;
      allow create, update: if isAudioUpload();
      allow delete: if isAdmin();
    }
  }
}
